<Page x:Class="FileSystemVisualizer.Views.FatVisualizationView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FileSystemVisualizer.Views"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1400"
      Title="Visualización FAT">

    <Page.Resources>
        <local:RegionColorConverter x:Key="RegionColorConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Background="#f0f2f5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="20,15" BorderBrush="#e1e4e8" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="Bold" Foreground="#1a1f36"/>
                <TextBlock Text="{Binding DiskSummary}" FontSize="14" Foreground="#697386" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Add File/Directory Section -->
        <Border Grid.Row="1" Margin="20,20,20,10" Background="White" CornerRadius="8" Padding="20">
            <StackPanel>
                <TextBlock Text="➕ Añadir Archivo/Directorio" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- First Row -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Nombre" FontSize="12" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding NewEntryName, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Margin="10,0">
                            <TextBlock Text="Tipo" FontSize="12" Margin="0,0,0,5"/>
                            <ComboBox SelectedValue="{Binding NewEntryType}" SelectedValuePath="Content" Padding="8" Width="80">
                                <ComboBoxItem Content="F" IsSelected="True"/>
                                <ComboBoxItem Content="D"/>
                                <ComboBoxItem Content="L"/>
                            </ComboBox>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2" Margin="10,0">
                            <TextBlock Text="Tamaño (Registros)" FontSize="12" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding NewEntrySizeRecords, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="3" Margin="10,0,0,0">
                            <TextBlock Text="Archivo Enlazado (Hard Link)" FontSize="12" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding LinkedFileName, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Second Row -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <CheckBox Grid.Column="0" Content="Bloque específico" IsChecked="{Binding SpecifyStartBlock}" 
                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                        
                        <StackPanel Grid.Column="1" Margin="0,0,10,0" IsEnabled="{Binding SpecifyStartBlock}">
                            <TextBlock Text="Bloque Inicial" FontSize="12" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding NewEntryStartBlock, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                        </StackPanel>
                        
                        <Button Grid.Column="2" Content="+ Archivo/Link" Command="{Binding AddFileCommand}" 
                               Background="#4CAF50" Foreground="White" Padding="15,8" Margin="0,0,10,0" 
                               VerticalAlignment="Bottom" BorderThickness="0" Cursor="Hand"/>
                        
                        <Button Grid.Column="3" Content="+ Directorio" Command="{Binding AddDirectoryCommand}" 
                               Background="#2196F3" Foreground="White" Padding="15,8" 
                               VerticalAlignment="Bottom" BorderThickness="0" Cursor="Hand"/>
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,10,20,20">
                
                <!-- Directory Tree -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="📁 Estructura de Directorios" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>
                        <TreeView ItemsSource="{Binding RootDirectory.Children}" MaxHeight="200">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Type, StringFormat='[{0}]'}" Foreground="#666" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding SizeInRecords, StringFormat='{}{0} reg'}" Foreground="#999" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding SizeInBlocks, StringFormat='({0} bloq)'}" Foreground="#999" Margin="0,0,10,0"/>
                                        <Button Content="🗑️" Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=Page}}" 
                                               CommandParameter="{Binding}" Background="#f44336" Foreground="White" 
                                               Padding="4,2" BorderThickness="0" Cursor="Hand"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </StackPanel>
                </Border>

                <!-- Disk Structure (Horizontal Vector) -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <Grid Margin="0,0,0,15">
                            <TextBlock Text="🗂️ Estructura del Disco" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                            <Button Content="🔄 Actualizar" Command="{Binding RefreshCommand}" 
                                   HorizontalAlignment="Right" Padding="10,5" Background="#FF9800" 
                                   Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                        
                        <!-- Horizontal Vector Visualization -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding DiskBlocks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#333" BorderThickness="1" MinWidth="80" Height="80" Margin="0,0,-1,0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                
                                                <!-- Content: File name or region type -->
                                                <TextBlock Grid.Row="0" Text="{Binding FileName}" 
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                          FontSize="12" FontWeight="Bold" TextWrapping="Wrap" Margin="5"/>
                                                
                                                <!-- Block range -->
                                                <TextBlock Grid.Row="1" Text="{Binding BlockRangeDisplay}" 
                                                          HorizontalAlignment="Center" 
                                                          FontSize="10" Foreground="#666" Margin="5,0,5,5"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- FAT Table (2 Horizontal Rows) -->
                <Border Background="White" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock Text="📊 Tabla FAT" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>
                        
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Row 1: Values -->
                                <ItemsControl Grid.Row="0" ItemsSource="{Binding FatTableEntries}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#333" BorderThickness="1,1,1,0" Width="50" Height="30" Margin="0,0,-1,0">
                                                <TextBlock Text="{Binding DisplayText}" 
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                          FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <!-- Row 2: Indices -->
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding FatTableEntries}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#333" BorderThickness="1,0,1,1" Width="50" Height="30" Margin="0,0,-1,0">
                                                <TextBlock Text="{Binding BlockIndex}" 
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                          FontSize="9" Foreground="#666"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Border Grid.Row="3" Background="White" Padding="20" BorderBrush="#e1e4e8" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding BackCommand}" Content="← Atrás" Width="100" Height="35" 
                       Background="Transparent" BorderBrush="#cfd7df" BorderThickness="1" 
                       Foreground="#4f566b" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
