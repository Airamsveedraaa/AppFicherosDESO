<Page x:Class="FileSystemVisualizer.Views.FatInputFlexibleView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:FileSystemVisualizer.Helpers"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1000"
      Title="Configuración FAT Flexible"
      Background="#F5F5F5">

    <Page.Resources>
        <local:InvertBooleanConverter x:Key="InvertBooleanConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#3498DB" Padding="30,25">
            <StackPanel>
                <TextBlock Text="Configuración del Sistema FAT" 
                          FontSize="32" 
                          FontWeight="Bold" 
                          Foreground="White"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Configure los parámetros del disco - el sistema calculará automáticamente el resto" 
                          FontSize="16" 
                          Foreground="#ECF0F1"
                          HorizontalAlignment="Center"
                          Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="White" 
                    CornerRadius="10" 
                    Margin="50,30"
                    Padding="40">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="20" ShadowDepth="5"/>
                </Border.Effect>
                <StackPanel MaxWidth="800">
                    
                    <!-- Disk Configuration Section -->
                    <TextBlock Text="📁 Configuración del Disco (Panel Unificado)" 
                              FontSize="20" 
                              FontWeight="Bold"
                              Foreground="#2C3E50"
                              Margin="0,0,0,20"/>

                    <TextBlock Text="Modifique cualquier valor y los demás se actualizarán automáticamente." 
                              FontSize="13"
                              Foreground="#7F8C8D"
                              Margin="0,0,0,20"/>

                    <!-- Geometry (Optional) -->
                    <GroupBox Header="Geometría Física (Opcional)" 
                             FontSize="14"
                             FontWeight="SemiBold"
                             Margin="0,0,0,20"
                             Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Cilindros" FontSize="13" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Cylinders, UpdateSourceTrigger=PropertyChanged}" 
                                        FontSize="14" Padding="8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0">
                                <TextBlock Text="Cabezas" FontSize="13" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Heads, UpdateSourceTrigger=PropertyChanged}" 
                                        FontSize="14" Padding="8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="Sectores/Pista" FontSize="13" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding SectorsPerTrack, UpdateSourceTrigger=PropertyChanged}" 
                                        FontSize="14" Padding="8"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Logical Dimensions -->
                    <TextBlock Text="Dimensiones Lógicas" 
                              FontSize="16" 
                              FontWeight="SemiBold"
                              Foreground="#2C3E50"
                              Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Total de Sectores" FontSize="14" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding TotalSectorsInput, UpdateSourceTrigger=PropertyChanged}" 
                                    FontSize="14" Padding="10"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Total de Bloques" FontSize="14" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding TotalBlocksInput, UpdateSourceTrigger=PropertyChanged}" 
                                    FontSize="14" Padding="10"/>
                        </StackPanel>
                    </Grid>

                    <!-- Disk Capacity -->
                    <TextBlock Text="Capacidad Total" 
                              FontSize="16" 
                              FontWeight="SemiBold"
                              Foreground="#2C3E50"
                              Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                Text="{Binding DiskSizeValue, UpdateSourceTrigger=PropertyChanged}" 
                                FontSize="14"
                                Padding="10"
                                Margin="0,0,5,0"
                                BorderBrush="#BDC3C7"
                                BorderThickness="1"/>
                        <ComboBox Grid.Column="1"
                                 SelectedValue="{Binding DiskSizeUnit}"
                                 SelectedValuePath="Content"
                                 FontSize="14"
                                 Padding="10"
                                 BorderBrush="#BDC3C7"
                                 BorderThickness="1">
                            <ComboBoxItem Content="KB"/>
                            <ComboBoxItem Content="MB" IsSelected="True"/>
                            <ComboBoxItem Content="GB"/>
                        </ComboBox>
                    </Grid>

                    <!-- Sector Size -->
                    <TextBlock Text="Tamaño del Sector" 
                              FontSize="16" 
                              FontWeight="SemiBold"
                              Foreground="#2C3E50"
                              Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                Text="{Binding SectorSizeValue, UpdateSourceTrigger=PropertyChanged}" 
                                FontSize="14"
                                Padding="10"
                                Margin="0,0,5,0"
                                BorderBrush="#BDC3C7"
                                BorderThickness="1"/>
                        <ComboBox Grid.Column="1"
                                 SelectedValue="{Binding SectorSizeUnit}"
                                 SelectedValuePath="Content"
                                 FontSize="14"
                                 Padding="10"
                                 BorderBrush="#BDC3C7"
                                 BorderThickness="1">
                            <ComboBoxItem Content="Bytes" IsSelected="True"/>
                            <ComboBoxItem Content="KB"/>
                        </ComboBox>
                    </Grid>

                    <!-- Block Size -->
                    <TextBlock Text="Tamaño del Bloque" 
                              FontSize="16" 
                              FontWeight="SemiBold"
                              Foreground="#2C3E50"
                              Margin="0,0,0,10"/>
                    
                    <!-- Auto-calculate checkbox -->
                    <CheckBox Content="Calcular automáticamente (Bloque = N × Sector)" 
                              IsChecked="{Binding AutoCalculateBlockSize}"
                              FontSize="13"
                              Foreground="#34495E"
                              Margin="0,0,0,10"/>
                    
                    <!-- Multiplier (visible when auto-calculate is enabled) -->
                    <StackPanel Margin="0,0,0,10" Visibility="{Binding AutoCalculateBlockSize, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Multiplicador (N):" FontSize="13" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding BlockSizeMultiplier, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="14"
                                 Padding="10"
                                 Width="100"
                                 HorizontalAlignment="Left"
                                 BorderBrush="#BDC3C7"
                                 BorderThickness="1"/>
                    </StackPanel>
                    
                    <!-- Block Size Input (disabled when auto-calculate is active) -->
                    <Grid Margin="0,0,0,25" IsEnabled="{Binding AutoCalculateBlockSize, Converter={StaticResource InvertBooleanConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                Text="{Binding BlockSizeValue, UpdateSourceTrigger=PropertyChanged}" 
                                FontSize="14"
                                Padding="10"
                                Margin="0,0,5,0"
                                BorderBrush="#BDC3C7"
                                BorderThickness="1"/>
                        <ComboBox Grid.Column="1"
                                 SelectedValue="{Binding BlockSizeUnit}"
                                 SelectedValuePath="Content"
                                 FontSize="14"
                                 Padding="10"
                                 BorderBrush="#BDC3C7"
                                 BorderThickness="1">
                            <ComboBoxItem Content="Bytes"/>
                            <ComboBoxItem Content="KB" IsSelected="True"/>
                            <ComboBoxItem Content="MB"/>
                        </ComboBox>
                    </Grid>

                    <!-- Separator -->
                    <Border Height="1" Background="#E0E0E0" Margin="0,10,0,30"/>

                    <!-- FAT Configuration Section -->
                    <TextBlock Text="💾 Configuración FAT" 
                              FontSize="20" 
                              FontWeight="Bold"
                              Foreground="#2C3E50"
                              Margin="0,0,0,20"/>

                    <!-- FAT Type -->
                    <TextBlock Text="Tipo de FAT" 
                              FontSize="16" 
                              FontWeight="SemiBold"
                              Foreground="#2C3E50"
                              Margin="0,0,0,10"/>
                    <ComboBox SelectedValue="{Binding FatType}"
                             SelectedValuePath="Content"
                             FontSize="14"
                             Padding="10"
                             Margin="0,0,0,10"
                             BorderBrush="#BDC3C7"
                             BorderThickness="1">
                        <ComboBoxItem Content="Auto" IsSelected="True"/>
                        <ComboBoxItem Content="FAT12"/>
                        <ComboBoxItem Content="FAT16"/>
                        <ComboBoxItem Content="FAT32"/>
                    </ComboBox>

                    <!-- Show calculated FAT info -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock FontSize="12" Foreground="#666" Margin="0,5,0,3">
                            <Run Text="Información FAT se calculará al continuar"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Reserved Blocks (Boot Area) -->
                    <TextBlock Text="Bloques Reservados (Boot Area)" 
                              FontSize="16" 
                              FontWeight="SemiBold"
                              Foreground="#2C3E50"
                              Margin="0,0,0,10"/>
                    <TextBox Text="{Binding ReservedBlocks, UpdateSourceTrigger=PropertyChanged}" 
                            FontSize="14"
                            Padding="10"
                            Margin="0,0,0,20"
                            BorderBrush="#BDC3C7"
                            BorderThickness="1"/>

                    <!-- Number of FAT Copies -->
                    <TextBlock Text="Número de Copias de la FAT" 
                              FontSize="16" 
                              FontWeight="SemiBold"
                              Foreground="#2C3E50"
                              Margin="0,0,0,10"/>
                    <TextBox Text="{Binding NumberOfFats, UpdateSourceTrigger=PropertyChanged}" 
                            FontSize="14"
                            Padding="10"
                            Margin="0,0,0,20"
                            BorderBrush="#BDC3C7"
                            BorderThickness="1"/>

                    <!-- Record Size -->
                    <TextBlock Text="Tamaño del Registro (Bytes)" 
                              FontSize="16" 
                              FontWeight="SemiBold"
                              Foreground="#2C3E50"
                              Margin="0,0,0,10"/>
                    <TextBox Text="{Binding RecordSizeBytes, UpdateSourceTrigger=PropertyChanged}" 
                            FontSize="14"
                            Padding="10"
                            Margin="0,0,0,20"
                            BorderBrush="#BDC3C7"
                            BorderThickness="1"/>

                    <!-- Number of Files -->
                    <TextBlock Text="Número de Archivos a Crear" 
                              FontSize="16" 
                              FontWeight="SemiBold"
                              Foreground="#2C3E50"
                              Margin="0,0,0,10"/>
                    <TextBox Text="{Binding NumberOfFiles, UpdateSourceTrigger=PropertyChanged}" 
                            FontSize="14"
                            Padding="10"
                            Margin="0,0,0,20"
                            BorderBrush="#BDC3C7"
                            BorderThickness="1"/>

                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="White" Padding="30,20" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid MaxWidth="800">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" 
                       Content="← Volver" 
                       Command="{Binding BackCommand}"
                       FontSize="16"
                       Padding="20,12"
                       Background="#95A5A6"
                       Foreground="White"
                       BorderThickness="0"
                       Cursor="Hand"
                       HorizontalAlignment="Left"
                       Width="150">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                               CornerRadius="5"
                                               Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#7F8C8D"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="1" 
                       Content="Continuar →" 
                       Command="{Binding ContinueCommand}"
                       FontSize="16"
                       Padding="20,12"
                       Background="#27AE60"
                       Foreground="White"
                       BorderThickness="0"
                       Cursor="Hand"
                       Width="150">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                               CornerRadius="5"
                                               Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#229954"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
