<Page x:Class="FileSystemVisualizer.Views.NtfsInputFlexibleView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:helpers="clr-namespace:FileSystemVisualizer.Helpers"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="900"
      Title="Configuración NTFS Flexible"
      Background="#F5F5F5">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <helpers:InvertBooleanConverter x:Key="InvertBooleanConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2ECC71" Padding="30,25">
            <StackPanel>
                <TextBlock Text="Configuración del Sistema NTFS" 
                          FontSize="32" 
                          FontWeight="Bold" 
                          Foreground="White"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Configure la Master File Table según sus necesidades" 
                          FontSize="16" 
                          Foreground="#ECF0F1"
                          HorizontalAlignment="Center"
                          Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="White" 
                    CornerRadius="10" 
                    Margin="50,30"
                    Padding="40">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="20" ShadowDepth="5"/>
                </Border.Effect>
                <StackPanel MaxWidth="700">
                    
                    <!-- Disk Configuration Section -->
                    <TextBlock Text="📁 Configuración del Disco (Panel Unificado)" 
                              FontSize="20" 
                              FontWeight="Bold"
                              Foreground="#2C3E50"
                              Margin="0,0,0,20"/>

                    <TextBlock Text="Modifique cualquier valor y los demás se actualizarán automáticamente." 
                               FontSize="12" Foreground="Gray" Margin="0,0,0,15" FontStyle="Italic"/>
                    
                    <!-- Geometry Input Panel -->
                    <GroupBox Header="Geometría Física (Opcional)" Margin="0,0,0,15" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Cilindros"/>
                                <TextBox Text="{Binding Cylinders, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                <TextBlock Text="Cabezas"/>
                                <TextBox Text="{Binding Heads, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="5,0,0,0">
                                <TextBlock Text="Sectores/Pista"/>
                                <TextBox Text="{Binding SectorsPerTrack, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Sectors and Blocks Panel -->
                    <GroupBox Header="Dimensiones Lógicas" Margin="0,0,0,15" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Total de Sectores"/>
                                <TextBox Text="{Binding TotalSectorsInput, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Total de Bloques/Clústeres"/>
                                <TextBox Text="{Binding TotalBlocksInput, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Capacity Panel -->
                     <GroupBox Header="Capacidad Total" Margin="0,0,0,25" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox Grid.Column="0"
                                    Text="{Binding DiskSizeValue, UpdateSourceTrigger=PropertyChanged}" 
                                    FontSize="14"
                                    Padding="10"
                                    Margin="0,0,5,0"
                                    BorderBrush="#BDC3C7"
                                    BorderThickness="1"/>
                            <ComboBox Grid.Column="1"
                                     SelectedValue="{Binding DiskSizeUnit}"
                                     SelectedValuePath="Content"
                                     FontSize="14"
                                     Padding="10"
                                     BorderBrush="#BDC3C7"
                                     BorderThickness="1">
                                <ComboBoxItem Content="Bytes"/>
                                <ComboBoxItem Content="KB"/>
                                <ComboBoxItem Content="MB"/>
                                <ComboBoxItem Content="GB" IsSelected="True"/>
                            </ComboBox>
                        </Grid>
                    </GroupBox>

                    <!-- Cluster Size -->
                    <TextBlock Text="Tamaño del Clúster *" 
                              FontSize="16" 
                              FontWeight="SemiBold"
                              Foreground="#2C3E50"
                              Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                Text="{Binding ClusterSizeValue, UpdateSourceTrigger=PropertyChanged}" 
                                FontSize="14"
                                Padding="10"
                                Margin="0,0,5,0"
                                BorderBrush="#BDC3C7"
                                BorderThickness="1"/>
                        <ComboBox Grid.Column="1"
                                 SelectedValue="{Binding ClusterSizeUnit}"
                                 SelectedValuePath="Content"
                                 FontSize="14"
                                 Padding="10"
                                 BorderBrush="#BDC3C7"
                                 BorderThickness="1">
                            <ComboBoxItem Content="Bytes"/>
                            <ComboBoxItem Content="KB" IsSelected="True"/>
                            <ComboBoxItem Content="Sectores"/>
                        </ComboBox>
                    </Grid>

                    <!-- Separator -->
                    <Border Height="1" Background="#E0E0E0" Margin="0,10,0,30"/>

                    <!-- MFT Configuration Section -->
                    <TextBlock Text="📊 Configuración de la MFT" 
                              FontSize="20" 
                              FontWeight="Bold"
                              Foreground="#2C3E50"
                              Margin="0,0,0,20"/>

                    <!-- MFT Entry Size -->
                    <TextBlock Text="Tamaño de Entrada MFT" 
                              FontSize="16" 
                              FontWeight="SemiBold"
                              Foreground="#2C3E50"
                              Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                Text="{Binding MftEntrySizeValue, UpdateSourceTrigger=PropertyChanged}" 
                                FontSize="14"
                                Padding="10"
                                Margin="0,0,5,0"
                                BorderBrush="#BDC3C7"
                                BorderThickness="1"/>
                        <ComboBox Grid.Column="1"
                                 SelectedValue="{Binding MftEntrySizeUnit}"
                                 SelectedValuePath="Content"
                                 FontSize="14"
                                 Padding="10"
                                 BorderBrush="#BDC3C7"
                                 BorderThickness="1">
                            <ComboBoxItem Content="Bytes"/>
                            <ComboBoxItem Content="KB" IsSelected="True"/>
                        </ComboBox>
                    </Grid>
                    <TextBlock Text="💡 Típicamente 1 KB por entrada" 
                              FontSize="12" 
                              Foreground="#7F8C8D"
                              FontStyle="Italic"
                              Margin="0,5,0,25"
                              TextWrapping="Wrap"/>

                    <!-- Optional: MFT Zone Percentage -->
                    <CheckBox Content="Especificar porcentaje de MFT Zone"
                             IsChecked="{Binding SpecifyMftZonePercentage}"
                             FontSize="14"
                             Foreground="#34495E"
                             Margin="0,0,0,10"/>
                    <Grid Margin="20,0,0,10" 
                          IsEnabled="{Binding SpecifyMftZonePercentage}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                Text="{Binding MftZonePercentage, UpdateSourceTrigger=PropertyChanged}" 
                                FontSize="14"
                                Padding="10"
                                Margin="0,0,5,0"
                                BorderBrush="#BDC3C7"
                                BorderThickness="1"/>
                        <TextBlock Grid.Column="1"
                                  Text="%"
                                  FontSize="14"
                                  VerticalAlignment="Center"
                                  Margin="10,0,0,0"
                                  Foreground="#7F8C8D"/>
                    </Grid>
                    <TextBlock Text="💡 Por defecto 12.5% del disco" 
                              FontSize="12" 
                              Foreground="#7F8C8D"
                              FontStyle="Italic"
                              Margin="20,5,0,25"
                              TextWrapping="Wrap"/>

                    <!-- Optional: MFT Size -->
                    <CheckBox Content="Especificar tamaño de la MFT directamente (si no, se calcula del porcentaje)"
                             IsChecked="{Binding SpecifyMftSize}"
                             FontSize="14"
                             Foreground="#34495E"
                             Margin="0,0,0,10"/>
                    <Grid Margin="20,0,0,25" 
                          IsEnabled="{Binding SpecifyMftSize}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                Text="{Binding MftSizeValue, UpdateSourceTrigger=PropertyChanged}" 
                                FontSize="14"
                                Padding="10"
                                Margin="0,0,5,0"
                                BorderBrush="#BDC3C7"
                                BorderThickness="1"/>
                        <ComboBox Grid.Column="1"
                                 SelectedValue="{Binding MftSizeUnit}"
                                 SelectedValuePath="Content"
                                 FontSize="14"
                                 Padding="10"
                                 BorderBrush="#BDC3C7"
                                 BorderThickness="1">
                            <ComboBoxItem Content="Bytes"/>
                            <ComboBoxItem Content="KB"/>
                            <ComboBoxItem Content="MB" IsSelected="True"/>
                            <ComboBoxItem Content="GB"/>
                        </ComboBox>
                    </Grid>

                    <!-- Separator -->
                    <Border Height="1" Background="#E0E0E0" Margin="0,10,0,30"/>

                    <!-- Simulation Section -->
                    <TextBlock Text="🎲 Simulación" 
                              FontSize="20" 
                              FontWeight="Bold"
                              Foreground="#2C3E50"
                              Margin="0,0,0,20"/>

                    <!-- Number of Files -->
                    <TextBlock Text="Número de Archivos a Simular" 
                              FontSize="16" 
                              FontWeight="SemiBold"
                              Foreground="#2C3E50"
                              Margin="0,0,0,10"/>
                    <TextBox Text="{Binding NumberOfFiles, UpdateSourceTrigger=PropertyChanged}" 
                            FontSize="14"
                            Padding="10"
                            Margin="0,0,0,25"
                            BorderBrush="#BDC3C7"
                            BorderThickness="1"/>

                    <!-- Resident File Percentage -->
                    <TextBlock Text="Porcentaje de Archivos Residentes" 
                              FontSize="16" 
                              FontWeight="SemiBold"
                              Foreground="#2C3E50"
                              Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                Text="{Binding ResidentFilePercentage, UpdateSourceTrigger=PropertyChanged}" 
                                FontSize="14"
                                Padding="10"
                                Margin="0,0,5,0"
                                BorderBrush="#BDC3C7"
                                BorderThickness="1"/>
                        <TextBlock Grid.Column="1"
                                  Text="%"
                                  FontSize="14"
                                  VerticalAlignment="Center"
                                  Margin="10,0,0,0"
                                  Foreground="#7F8C8D"/>
                    </Grid>
                    <TextBlock Text="💡 Archivos residentes guardan sus datos dentro de la entrada MFT" 
                              FontSize="12" 
                              Foreground="#7F8C8D"
                              FontStyle="Italic"
                              Margin="0,5,0,0"
                              TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="White" Padding="30,20" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid MaxWidth="800">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" 
                       Command="{Binding BackCommand}"
                       Content="← Volver" 
                       FontSize="16"
                       Padding="20,12"
                       Margin="0,0,10,0"
                       Background="#95A5A6"
                       Foreground="White"
                       BorderThickness="0"
                       Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                               CornerRadius="5"
                                               Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#7F8C8D"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="1" 
                       Command="{Binding ContinueCommand}"
                       Content="Continuar →" 
                       FontSize="16"
                       Padding="20,12"
                       Margin="10,0,0,0"
                       Background="#2ECC71"
                       Foreground="White"
                       BorderThickness="0"
                       Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                               CornerRadius="5"
                                               Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#27AE60"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#BDC3C7"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
